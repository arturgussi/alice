{
  "name": "alice",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "depcheck": "depcheck --ignore-patterns=android,ios",
    "checkupdates": "ncu",
    "clean": "rimraf node_modules android/app/build",
    "fullclean": "npm cache clean --force && rimraf node_modules && rimraf android/.gradle && rimraf android/build && rimraf android/app/build && rimraf android/.cxx && rimraf android/app/.cxx",
    "start": "react-native start",
    "start:cache": "start \"\" npx react-native start --reset-cache",
    "gradlew:clean": "cd android && gradlew clean",
    "android": "npx react-native run-android",
    "android:clean": "npm run gradlew:clean && npm run android",
    "android:fullclean": "npm run fullclean && timeout 5 && npm install && timeout 5 && npm run start:cache && timeout 5 && npm run gradlew:clean && timeout 5 && npm install && timeout 5 && npm run android",
    "ios": "react-native run-ios",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier --write src/",
    "format": "npm run prettier && npm run lint:fix",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-firebase/app": "^22.2.0",
    "@react-native-firebase/auth": "^22.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-picker/picker": "^2.11.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/drawer": "^7.3.12",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.11",
    "@tanstack/react-query": "^5.77.2",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-ble-manager": "^12.1.4",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "^2.25.0",
    "react-native-gifted-charts": "^1.4.61",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modalize": "^2.1.1",
    "react-native-permissions": "^5.4.0",
    "react-native-portalize": "^1.0.7",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.10.0",
    "react-native-svg": "^15.11.2",
    "react-native-vector-icons": "^10.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/css": "^0.8.1",
    "@eslint/js": "^9.27.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "^0.79.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.1.0",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4",
    "typescript-eslint": "^8.32.1"
  },
  "engines": {
    "node": ">=18"
  }
}
